# Copia este archivo a .env y ajusta los valores a tu entorno local.
# NUNCA subas el archivo .env real (ya está en .gitignore).

# ── Rutas de datos y artefactos ────────────────────────────────────────────
# Sobrescribe la raíz de datos si no usas la ubicación por defecto (src/data).
ECGI_DATA_ROOT=./src/data
# Directorio de checkpoints (por defecto: src/checkpoints).
ECGI_CHECKPOINT_DIR=./src/checkpoints
# Directorio de resultados/curvas (por defecto: src/loss_curves).
ECGI_REPORTS_DIR=./reports

# ── Cómputo ─────────────────────────────────────────────────────────────────
# GPU(s) visibles para el proceso (formato CUDA_VISIBLE_DEVICES estándar).
CUDA_VISIBLE_DEVICES=0
# Núcleos de CPU reservados para Ray (ver ray.init(num_cpus=...) en run_bohb.py).
RAY_NUM_CPUS=6
# GPUs reservadas para Ray (ver ray.init(num_gpus=...) en run_bohb.py).
RAY_NUM_GPUS=1

# ── Trazabilidad experimental (opcional, ver docs/reproducibility.md) ──────
ECGI_GLOBAL_SEED=42
# Backend de tracking opcional (mlflow/wandb), solo si se activa la
# integración experimental en src/training/engines.py (actualmente no está
# conectada al pipeline principal, ver MIGRATION_REPORT.md).
# MLFLOW_TRACKING_URI=
# WANDB_API_KEY=

# TODO: completar variables adicionales si el equipo introduce
# almacenamiento remoto de datos/checkpoints (S3, GCS, almacenamiento
# institucional, etc.).
