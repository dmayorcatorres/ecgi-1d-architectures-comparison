# Normaliza finales de línea para texto, evita conflictos multiplataforma.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binarios: nunca aplicar diff/merge de texto ni normalización de línea.
*.pt binary
*.pth binary
*.mat binary
*.npz binary
*.npy binary
*.pkl binary
*.png binary
*.xlsx binary
*.deb binary

# Si el equipo adopta Git LFS para datasets/checkpoints livianos versionados
# (ver data/README.md), descomentar y ajustar:
# *.pt filter=lfs diff=lfs merge=lfs -text
# *.mat filter=lfs diff=lfs merge=lfs -text
